[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/space_integration/bin/libgodot_space_integration.so"
linux.release.x86_64 = "res://addons/space_integration/bin/libgodot_space_integration.so"
macos.debug = "res://addons/space_integration/bin/libgodot_space_integration.dylib"
macos.release = "res://addons/space_integration/bin/libgodot_space_integration.dylib"
windows.debug.x86_64 = "res://addons/space_integration/bin/godot_space_integration.dll"
windows.release.x86_64 = "res://addons/space_integration/bin/godot_space_integration.dll"